# Copie para .env e ajuste. Nunca versione o .env real.
PORT=3000
NODE_ENV=development

# --- Banco de dados ---------------------------------------------------------
# Produção: PostgreSQL gerenciado (Render/Railway/Fly/Neon/Supabase).
# Ex.: postgres://usuario:senha@host:5432/aurora?sslmode=require
DATABASE_URL=
# Sem DATABASE_URL o app usa PGlite local em ./data/aurora (só para desenvolvimento).
DATABASE_PATH=./data/aurora
DB_POOL_MAX=10
DB_CONNECT_RETRIES=15
DB_STATEMENT_TIMEOUT_MS=30000
# Em produção exige DATABASE_URL. Use "true" só em teste de container.
ALLOW_EPHEMERAL_DB=false
# Migrações rodam no boot sob trava de banco. "false" deixa para `npm run migrate`.
MIGRATE_ON_START=true

# --- Segurança --------------------------------------------------------------
# Obrigatória quando NODE_ENV=production (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:3000
ALLOW_REGISTRATION=true
# Nome da versão exibido no /api/ready (útil para conferir o deploy).
APP_VERSION=1.0.0

# --- E-mail (redefinição de senha) -----------------------------------------
# Sem SMTP_URL o sistema funciona, mas o link de redefinição não é enviado:
# em desenvolvimento ele aparece no terminal; em produção o pedido é registrado
# como "não enviado" e a API responde igual (sem revelar se o e-mail existe).
# Exemplos: smtps://usuario:senha@smtp.exemplo.com:465 (@smtp.gmail.com:587 + /?secure=false)
SMTP_URL=
MAIL_FROM=Aurora Agenda <nao-responda@seudominio.com.br>
SMTP_TIMEOUT_MS=10000
RESET_TOKEN_TTL_MINUTES=30

# --- WhatsApp ---------------------------------------------------------------
# disabled = fila funciona sem enviar; live = envio real pela API oficial da Meta.
WHATSAPP_MODE=disabled
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_TIMEOUT_MS=12000

# --- Fila de mensagens ------------------------------------------------------
WORKER_MAX_ATTEMPTS=5
WORKER_INTERVAL_MS=15000
WORKER_STALE_MS=120000
WORKER_HEARTBEAT_MAX_AGE_MS=90000

# --- Desenvolvimento --------------------------------------------------------
# Demonstração local: cria dados fictícios e habilita o acesso de demonstração.
DEMO_MODE=true
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
